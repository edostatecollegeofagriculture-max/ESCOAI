# Local development only. Never commit real credentials.
FLASK_CONFIG=development
DEV_DATABASE_URL=sqlite:///edocas_dev.db
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
CORS_ORIGINS=http://localhost:5173

# Production Render API environment
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# RATELIMIT_STORAGE_URI=rediss://USER:PASSWORD@REDIS-HOST:PORT/0 (required for production)
# CORS_ORIGINS=https://YOUR-FRONTEND.vercel.app,https://your-custom-domain.example
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_FOLDER=edscoai
# MAX_UPLOAD_BYTES=10485760

# Vercel frontend environment variable (Production + Preview as appropriate)
# VITE_API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
