    def test_postgresql_score_submission_uses_transaction_advisory_lock(self):
        self.add_lecturer_assignment()
        self.add_approved_registration()

        headers = self.login_headers("lecturer")
        session_obj = db.session()
        original_execute = session_obj.execute

        get_bind_patch, execute_patch, lock_calls = (
            self.mock_postgresql_advisory_lock(session_obj)
        )

        with get_bind_patch, execute_patch:
            response = self.client.post(
                "/api/v1/results/score-entry",
                json=self.score_payload(),
                headers=headers,
            )

        self.assertEqual(
            response.status_code,
            201,
            msg=str(response.get_json()),
        )

        self.assertEqual(
            len(lock_calls),
            1,
            "PostgreSQL score submission must acquire exactly one "
            "transaction-scoped advisory lock.",
        )

        lock_parameters = lock_calls[0][1]
        self.assertEqual(
            lock_parameters["lock_key"],
            "rbac-student-1|rbac-course-1|2025/2026|First Semester",
        )

    def test_postgresql_lock_path_preserves_score_and_audit(self):
        self.add_lecturer_assignment()
        self.add_approved_registration()

        headers = self.login_headers("lecturer")
        session_obj = db.session()
        original_execute = session_obj.execute

        get_bind_patch, execute_patch, lock_calls = (
            self.mock_postgresql_advisory_lock(session_obj)
        )

        with get_bind_patch, execute_patch:
            response = self.client.post(
                "/api/v1/results/score-entry",
                json=self.score_payload(),
                headers=headers,
            )

        self.assertEqual(
            response.status_code,
            201,
            msg=str(response.get_json()),
        )

        self.assertEqual(
            len(lock_calls),
            1,
            "The PostgreSQL lock path must request exactly one advisory lock.",
        )

        result_id = response.get_json()["result"]["id"]

        stored_result = PortalRecord.query.filter_by(
            collection="results",
            record_key=result_id,
        ).first()

        self.assertIsNotNone(
            stored_result,
            "The score result should persist after the lock is acquired.",
        )

        stored_audit = PortalRecord.query.filter_by(
            collection="auditLogs",
        ).all()

        matching_audits = [
            row.payload for row in stored_audit
            if row.payload.get("action") == "RESULT_SCORE_SUBMITTED"
            and row.payload.get("details", {}).get("resultId") == result_id
        ]

        self.assertEqual(
            len(matching_audits),
            1,
            "The successful score transaction must persist exactly one audit event.",
        )



